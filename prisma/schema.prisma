// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  role         String  @default("employee") // "employee", "manager", "admin"
  department   String?
  title        String?
  avatarUrl    String?
  passwordHash String?

  tags Tag[] @relation("UserTags")

  // Submissions created by this user
  timesheets      Timesheet[]      @relation("TimesheetSubmitter")
  transferRecords TransferRecord[] @relation("TransferSubmitter")
  incidentReports IncidentReport[] @relation("IncidentSubmitter")
  timeOffRequests TimeOffRequest[] @relation("TimeOffSubmitter")
  fundingRequests FundingRequest[] @relation("FundingSubmitter")

  // Authored interactions
  comments     Comment[]  @relation("CommentAuthor")
  uploadedDocs Document[] @relation("DocumentUploader")
  newsPosts    NewsPost[] @relation("NewsAuthor")

  tasks         Task[] @relation("TaskAssignee")
  tasksAssigned Task[] @relation("TaskAssigner")

  notifications Notification[] @relation("NotificationRecipient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(cuid())
  name String @unique // e.g. "MB Manager", "ADMIN", "MB Employee"
  type String // "MANAGER", "EMPLOYEE", "ADDITIONAL"

  users User[] @relation("UserTags")

  /// Form types routed to this tag. See FormRouting.
  routedForms FormRouting[] @relation("FormRoutingTags")

  // Many-To-Many Form Assignments
  assignedTimesheets      Timesheet[]      @relation("TimesheetTagApprovers")
  assignedTransferRecords TransferRecord[] @relation("TransferTagApprovers")
  assignedIncidentReports IncidentReport[] @relation("IncidentTagApprovers")
  assignedTimeOff         TimeOffRequest[] @relation("TimeOffTagApprovers")
  assignedFunding         FundingRequest[] @relation("FundingTagApprovers")
}

model Document {
  id         String @id @default(cuid())
  name       String
  type       String // "pdf", "docx", "xlsx"
  category   String // "POLICY MANUALS", "STANDARDS OF PRACTICE", etc.
  sizeBytes  Int
  sharedWith String @default("all") // "all" | "managers"

  /// Public path of the stored file, e.g. /uploads/docs/<id>.pdf
  fileUrl      String?
  /// The name the file had when it was uploaded, used for the download.
  originalName String?

  authorId String?
  author   User?   @relation("DocumentUploader", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id      String @id @default(cuid())
  content String

  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])

  // Optional relations to map this comment to a specific form payload
  timesheetId String?
  timesheet   Timesheet? @relation(fields: [timesheetId], references: [id])

  transferRecordId String?
  transferRecord   TransferRecord? @relation(fields: [transferRecordId], references: [id])

  incidentReportId String?
  incidentReport   IncidentReport? @relation(fields: [incidentReportId], references: [id])

  timeOffRequestId String?
  timeOffRequest   TimeOffRequest? @relation(fields: [timeOffRequestId], references: [id])

  fundingRequestId String?
  fundingRequest   FundingRequest? @relation(fields: [fundingRequestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Timesheet {
  id          String @id @default(cuid())
  submitterId String
  submitter   User   @relation("TimesheetSubmitter", fields: [submitterId], references: [id])

  assignedTags Tag[] @relation("TimesheetTagApprovers")

  date         DateTime?
  timeIn       String?
  timeOut      String?
  lunchHour    Float?
  overTime     Float?
  transferTime Float?
  totalHours   Float?

  status   String    @default("PENDING") // PENDING, APPROVED, REJECTED
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransferRecord {
  id          String @id @default(cuid())
  submitterId String
  submitter   User   @relation("TransferSubmitter", fields: [submitterId], references: [id])

  assignedTags Tag[] @relation("TransferTagApprovers")

  date             DateTime?
  time             String?
  team             String?
  transferType     String? // "Standard", "M.E.", "Non-M.E. Police"
  deceasedName     String?
  placeOfDeath     String?
  nokName          String?
  nokRelation      String?
  nokContact       String?
  constName        String?
  constNumber      String?
  meName           String?
  twoStaffApproved String? // Changed to String? since form submits 'Yes' or 'No'. DB type previously Boolean?
  notes            String?

  status   String    @default("PENDING")
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncidentReport {
  id          String @id @default(cuid())
  submitterId String
  submitter   User   @relation("IncidentSubmitter", fields: [submitterId], references: [id])

  assignedTags Tag[] @relation("IncidentTagApprovers")

  incidentDate     DateTime?
  incidentLocation String?
  nature           String? // "Injury", "Damage", "Legal"
  notes            String?
  certified        String? // Checkbox value can be "on" or null

  status   String    @default("PENDING")
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeOffRequest {
  id          String @id @default(cuid())
  submitterId String
  submitter   User   @relation("TimeOffSubmitter", fields: [submitterId], references: [id])

  assignedTags Tag[] @relation("TimeOffTagApprovers")

  startDate DateTime?
  endDate   DateTime?
  reason    String?

  status   String    @default("PENDING")
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FundingRequest {
  id          String @id @default(cuid())
  submitterId String
  submitter   User   @relation("FundingSubmitter", fields: [submitterId], references: [id])

  assignedTags Tag[] @relation("FundingTagApprovers")

  amount     Float?
  purpose    String?
  dateNeeded DateTime?

  status   String    @default("PENDING")
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyLineup {
  id    String @id @default(cuid())
  date  String @unique // YYYY-MM-DD
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduledService {
  id       String @id @default(cuid())
  title    String
  date     String // YYYY-MM-DD
  time     String?
  location String?

  assignments ServiceRoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceRoleAssignment {
  id        String @id @default(cuid())
  roleName  String
  staffName String

  serviceId String
  service   ScheduledService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Company news and updates written by the communications team and shown on
/// every member's dashboard. Drafts stay invisible to staff until published.
model NewsPost {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String
  body    String

  /// "ARTICLE" | "VIDEO" | "RESOURCE"
  mediaType String @default("ARTICLE")

  /// Featured image shown on the dashboard card.
  imageUrl String?
  /// Intrinsic size of that image, so cards can reserve the right space and
  /// the masonry grid does not reflow as images load.
  imageWidth  Int?
  imageHeight Int?
  /// External video link (YouTube/Vimeo) for VIDEO posts.
  videoUrl String?
  /// Link or attachment for RESOURCE posts.
  resourceUrl String?

  /// "DRAFT" | "PUBLISHED"
  status      String    @default("DRAFT")
  publishedAt DateTime?

  /// Pins a post to the top of the feed.
  pinned Boolean @default(false)

  authorId String?
  author   User?   @relation("NewsAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

/// A job given to one member of staff for a particular day by their manager.
/// Shows on that person's dashboard alongside the services they are rostered on.
model Task {
  id     String  @id @default(cuid())
  title  String
  detail String?

  /// "YYYY-MM-DD". Stored as a calendar date rather than a timestamp so it
  /// cannot drift a day across time zones, matching ScheduledService.date.
  dueDate String

  /// "OPEN" | "DONE"
  status      String    @default("OPEN")
  completedAt DateTime?

  /// "NORMAL" | "HIGH"
  priority String @default("NORMAL")

  assigneeId String
  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy   User?   @relation("TaskAssigner", fields: [assignedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, dueDate])
  @@index([dueDate, status])
}

/// Tells someone that something happened to their work: a submission was
/// reviewed, a task was assigned, news was published. Without this the app
/// makes decisions that never reach the person they affect.
model Notification {
  id      String  @id @default(cuid())
  title   String
  body    String?
  /// Where clicking it should take the reader.
  href    String?
  /// "SUBMISSION" | "TASK" | "NEWS"
  kind    String  @default("SUBMISSION")
  readAt  DateTime?

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([recipientId, readAt])
}

/// Which tags a given form type is routed to.
///
/// The per-submission join tables (_TimesheetTagApprovers and friends) record
/// who a *particular* record went to. This records the standing rule, and is
/// copied onto each submission at the moment it is created — so changing the
/// rule never rewrites the history of records already filed.
model FormRouting {
  id String @id @default(cuid())

  /// "timesheet" | "transfer" | "incident" | "timeoff" | "funding"
  formType String @unique

  tags Tag[] @relation("FormRoutingTags")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
