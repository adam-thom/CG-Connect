# Copy to .env for local work. Every one of these must also be set in the
# Vercel project settings before the first deploy.

# Where the data lives.
# Local: a SQLite file.
# Deployed: a hosted libSQL database — a file URL cannot work on a serverless
# host, because the filesystem is read-only and is discarded between requests.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="libsql://cg-connect-<org>.turso.io"
# TURSO_AUTH_TOKEN=""

# Signs the session cookie. At least 32 random characters, and never the same
# value in production as anywhere else — anyone holding it can mint a cookie
# claiming any role. Generate one with:  openssl rand -base64 32
SESSION_SECRET=""

# Set automatically once a Blob store is attached to the Vercel project.
# Without it, uploaded documents and news images have nowhere to go: a
# deployment cannot write to public/.
# BLOB_READ_WRITE_TOKEN=""
